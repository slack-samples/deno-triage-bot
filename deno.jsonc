{
  "$schema": "https://deno.land/x/deno/cli/schemas/config-file.v1.json",
  "fmt": {
    "include": [
      "README.md",
      "datastores",
      "external_auth",
      "functions",
      "manifest.ts",
      "triggers",
      "types",
      "views",
      "workflows"
    ]
  },
  "lint": {
    "include": [
      "datastores",
      "external_auth",
      "functions",
      "manifest.ts",
      "triggers",
      "types",
      "views",
      "workflows"
    ]
  },
  "lock": false,
  "tasks": {
    "test": "deno fmt --check && deno lint && deno test --allow-read"
  },
  "imports": {
    "@slack/api": "jsr:@slack/api@2.9.0",
    "@slack/sdk": "jsr:@slack/sdk@2.15.2",

    "@std/assert": "jsr:@std/assert@^1.0.15",
    "cron-parser/": "https://deno.land/x/simple_cron@v0.1.0/"
  }
}
